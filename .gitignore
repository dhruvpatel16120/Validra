# ==============================================================================
# Validra .gitignore Configuration
# ==============================================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Temporary Folder Rule
# Track temp/ and temp/readme.txt, but ignore all other temporary files created inside temp/
temp/*
!temp/readme.txt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.nuxt/
dist/
.cache/

# Databases & Storage
*.sqlite
*.sqlite3
*.db
/storage/inspections/*
!/storage/inspections/.gitkeep

# IDE & Editor Settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db