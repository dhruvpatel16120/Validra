{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/verify-token",
      "destination": "/backend/main.py"
    },
    {
      "source": "/api/:path((?!auth/).*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/health",
      "destination": "/backend/main.py"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/backend/main.py"
    }
  ]
}